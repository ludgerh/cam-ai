server {
  listen 8000;
  server_name _;
  sendfile off;
  tcp_nopush on;
  access_log /var/log/nginx/cam-ai.access.log combined;
  error_log /var/log/nginx/cam-ai.error.log info;
  location /protected/ {
    internal;
    alias /home/ludger/temp/;
  }
  location /static/ {
    #Standard: /home/cam_ai/cam-ai/static/;
    alias /home/ludger/safe/sources/django/camai/static/;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }
  location / {
    proxy_pass http://127.0.0.1:8888;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_http_version 1.1;
    proxy_force_ranges on;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
  }
}
